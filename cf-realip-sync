#!/usr/bin/env python3
'''
Sync nginx's real_ip config with Cloudflare's published IP ranges.

Downloads Cloudflare's IPv4 and IPv6 lists, validates them, renders an nginx
conf (real_ip_header + set_real_ip_from per range) and, with --apply,
installs it, tests nginx, and reloads.  A failed nginx test restores the
previous file.  Dry run (default) prints the diff and changes nothing.

Exit codes: 0 = no change or applied, 1 = error (nothing left broken),
2 = usage/config error.

Usage:
    cf-realip-sync                    # dry run: show diff
    cf-realip-sync --apply            # install, test, reload (if changed)
    cf-realip-sync --config PATH      # default: config.ini beside this file
'''
import argparse
import configparser
import difflib
import ipaddress
import os
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.request
from dataclasses import dataclass
from pathlib import Path

# =============================================================================
# Constants
# =============================================================================
REPO_URL = 'https://github.com/na-parse/cf-realip-sync'
USER_AGENT = 'cf-realip-sync/1.0'
DEFAULT_CONFIG = Path(__file__).resolve().parent / 'config.ini'


class SyncError(Exception):
    '''A failure that aborts the run; the message is the operator report.'''


# =============================================================================
# Config
# =============================================================================
@dataclass
class Config:
    '''Settings from config.ini (all keys have defaults).'''
    ipv4_url: str
    ipv6_url: str
    timeout: float
    retries: int
    min_ipv4: int
    min_ipv6: int
    max_removed_fraction: float
    output: Path
    header: str
    test_cmd: list[str]
    reload_cmd: list[str]
    notify_on_change: bool
    mail_to: str


def load_config(path: Path) -> Config:
    '''Read config.ini; missing file or keys fall back to defaults.'''
    cp = configparser.ConfigParser()
    cp.read_dict({
        'source': {
            'ipv4_url': 'https://www.cloudflare.com/ips-v4',
            'ipv6_url': 'https://www.cloudflare.com/ips-v6',
            'timeout': '20',
            'retries': '3',
        },
        'sanity': {
            'min_ipv4': '10',
            'min_ipv6': '5',
            'max_removed_fraction': '0.5',
        },
        'nginx': {
            'output': '/etc/nginx/conf.d/cloudflare-realip.conf',
            'header': 'CF-Connecting-IP',
            'test_cmd': 'nginx -t -q',
            'reload_cmd': 'systemctl reload nginx',
        },
        'notify': {'on_change': 'yes', 'mail_to': 'root'},
    })
    if path.exists():
        cp.read(path)
    elif path != DEFAULT_CONFIG:
        raise FileNotFoundError(f'config not found: {path}')
    s, n = cp['sanity'], cp['nginx']
    return Config(
        ipv4_url=cp['source']['ipv4_url'],
        ipv6_url=cp['source']['ipv6_url'],
        timeout=cp['source'].getfloat('timeout'),
        retries=cp['source'].getint('retries'),
        min_ipv4=s.getint('min_ipv4'),
        min_ipv6=s.getint('min_ipv6'),
        max_removed_fraction=s.getfloat('max_removed_fraction'),
        output=Path(n['output']),
        header=n['header'],
        test_cmd=shlex.split(n['test_cmd']),
        reload_cmd=shlex.split(n['reload_cmd']),
        notify_on_change=cp['notify'].getboolean('on_change'),
        mail_to=cp['notify']['mail_to'],
    )


# =============================================================================
# Fetch and validate
# =============================================================================
def fetch_text(url: str, timeout: float, retries: int) -> str:
    '''GET a URL as text, retrying with backoff.'''
    req = urllib.request.Request(url, headers={'User-Agent': USER_AGENT})
    last = ''
    for attempt in range(1, retries + 1):
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                ctype = resp.headers.get_content_type()
                body = resp.read().decode('utf-8', errors='replace')
            if ctype != 'text/plain':
                raise ValueError(f'unexpected content type {ctype}')
            return body
        except (OSError, ValueError) as exc:
            last = str(exc)
            if attempt < retries:
                time.sleep(5 * attempt)
    raise SyncError(f'fetch {url} failed after {retries} tries: {last}')


def parse_ranges(text: str, version: int) -> list[str]:
    '''Validate one CIDR per line for the given IP version; keep order.'''
    ranges: list[str] = []
    for num, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line:
            continue
        try:
            net = ipaddress.ip_network(line, strict=True)
        except ValueError:
            raise SyncError(
                f'IPv{version} line {num}: not a CIDR: {line!r}') from None
        if net.version != version:
            raise SyncError(f'IPv{version} list line {num}: {line} is IPv'
                            f'{net.version}')
        if str(net) in ranges:
            raise SyncError(f'IPv{version} list: duplicate {net}')
        ranges.append(str(net))
    return ranges


def check_sanity(cfg: Config, v4: list[str], v6: list[str],
                 current: list[str]) -> None:
    '''Refuse suspiciously short lists or large removals.'''
    if len(v4) < cfg.min_ipv4:
        raise SyncError(f'only {len(v4)} IPv4 ranges (min {cfg.min_ipv4})')
    if len(v6) < cfg.min_ipv6:
        raise SyncError(f'only {len(v6)} IPv6 ranges (min {cfg.min_ipv6})')
    if current:
        removed = set(current) - set(v4 + v6)
        frac = len(removed) / len(current)
        if frac > cfg.max_removed_fraction:
            raise SyncError(
                f'{len(removed)} of {len(current)} current ranges would be '
                f'removed ({frac:.0%} > {cfg.max_removed_fraction:.0%}); '
                f'refusing.  Check the lists, then raise max_removed_fraction '
                f'for one run if the change is real')


# =============================================================================
# Render and compare
# =============================================================================
def render(cfg: Config, v4: list[str], v6: list[str]) -> str:
    '''Build the nginx conf text (deterministic: no timestamps).'''
    lines = [
        f'# Managed by cf-realip-sync ({REPO_URL}).',
        '# Do not edit: overwritten on the next run.',
        f'# Sources: {cfg.ipv4_url} {cfg.ipv6_url}',
        f'real_ip_header {cfg.header};',
        'real_ip_recursive on;',
        '',
        '# IPv4',
        *[f'set_real_ip_from {r};' for r in v4],
        '',
        '# IPv6',
        *[f'set_real_ip_from {r};' for r in v6],
    ]
    return '\n'.join(lines) + '\n'


def ranges_in(text: str) -> list[str]:
    '''Extract set_real_ip_from values from an existing conf.'''
    out = []
    for line in text.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[0] == 'set_real_ip_from':
            out.append(parts[1].rstrip(';'))
    return out


def show_diff(old: str, new: str, path: Path) -> None:
    '''Print a unified diff of the conf change.'''
    sys.stdout.writelines(difflib.unified_diff(
        old.splitlines(keepends=True), new.splitlines(keepends=True),
        fromfile=f'{path} (current)', tofile=f'{path} (new)'))


# =============================================================================
# Apply
# =============================================================================
def _run(cmd: list[str]) -> subprocess.CompletedProcess:
    '''Run a command, capturing output.'''
    return subprocess.run(cmd, capture_output=True, text=True)


def _write_atomic(path: Path, text: str) -> None:
    '''Write via a temp file in the same dir, then rename (mode 644).'''
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f'.{path.name}.')
    try:
        with os.fdopen(fd, 'w') as fh:
            fh.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise


def install(cfg: Config, old: str | None, new: str) -> None:
    '''Install new conf, test nginx, restore old on failure, then reload.'''
    backup = cfg.output.with_name(cfg.output.name + '.prev')
    if old is not None:
        shutil.copy2(cfg.output, backup)
    _write_atomic(cfg.output, new)
    test = _run(cfg.test_cmd)
    if test.returncode != 0:
        if old is not None:
            _write_atomic(cfg.output, old)
        else:
            cfg.output.unlink(missing_ok=True)
        recheck = _run(cfg.test_cmd)
        state = ('previous file restored, nginx test passes'
                 if recheck.returncode == 0
                 else 'previous file restored, BUT nginx test STILL FAILS')
        raise SyncError(f'nginx test failed with the new file; {state}.\n'
                        f'{test.stderr.strip()}')
    reload = _run(cfg.reload_cmd)
    if reload.returncode != 0:
        raise SyncError(f'new file installed and valid, but reload failed:\n'
                        f'{reload.stderr.strip()}')


def notify(cfg: Config, subject: str, body: str) -> None:
    '''Send mail via sendmail; a mail failure only warns.'''
    msg = (f'To: {cfg.mail_to}\nSubject: {subject}\n\n{body}\n')
    try:
        res = subprocess.run(['/usr/sbin/sendmail', '-t', '-oi'], input=msg,
                             capture_output=True, text=True, timeout=30)
        if res.returncode != 0:
            print(f'WARNING: sendmail failed: {res.stderr.strip()}',
                  file=sys.stderr)
    except (OSError, subprocess.TimeoutExpired) as exc:
        print(f'WARNING: sendmail failed: {exc}', file=sys.stderr)


# =============================================================================
# Main
# =============================================================================
def sync(cfg: Config, apply: bool) -> None:
    '''One run: fetch, validate, compare, and (with apply) install.'''
    v4 = parse_ranges(fetch_text(cfg.ipv4_url, cfg.timeout, cfg.retries), 4)
    v6 = parse_ranges(fetch_text(cfg.ipv6_url, cfg.timeout, cfg.retries), 6)
    old = cfg.output.read_text() if cfg.output.exists() else None
    current = ranges_in(old or '')
    check_sanity(cfg, v4, v6, current)
    new = render(cfg, v4, v6)
    print(f'Fetched {len(v4)} IPv4 + {len(v6)} IPv6 ranges')

    if old == new:
        print(f'No change: {cfg.output} is current')
        return
    added = sorted(set(v4 + v6) - set(current))
    removed = sorted(set(current) - set(v4 + v6))
    print(f'Change: +{len(added)} -{len(removed)} ranges'
          + ('' if added or removed else ' (formatting only)'))
    show_diff(old or '', new, cfg.output)
    if not apply:
        print('Dry run: nothing changed (use --apply)')
        return

    install(cfg, old, new)
    print(f'Installed {cfg.output}, nginx tested and reloaded')
    if cfg.notify_on_change and (added or removed):
        host = socket.getfqdn()
        notify(cfg, f'[cf-realip-sync] Cloudflare ranges changed on {host}',
               f'Added: {", ".join(added) or "-"}\n'
               f'Removed: {", ".join(removed) or "-"}\n\n'
               f'{cfg.output} updated and nginx reloaded.')


def main() -> int:
    '''CLI entry point.'''
    parser = argparse.ArgumentParser(
        description=__doc__.strip().splitlines()[0])
    parser.add_argument('--apply', action='store_true',
                        help='install, test and reload (default: dry run)')
    parser.add_argument('--config', type=Path, default=DEFAULT_CONFIG,
                        help='config file (default: %(default)s)')
    args = parser.parse_args()
    try:
        cfg = load_config(args.config)
    except (OSError, ValueError, configparser.Error) as exc:
        print(f'ERROR: config: {exc}', file=sys.stderr)
        return 2
    try:
        sync(cfg, args.apply)
    except SyncError as exc:
        print(f'ERROR: {exc}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
